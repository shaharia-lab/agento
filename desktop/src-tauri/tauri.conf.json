{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agento",
  "version": "0.1.0",
  "identifier": "com.shaharialab.agento",
  "mainBinaryName": "agento-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Agento",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 13 },
        "dragDropEnabled": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Shaharia Lab",
    "homepage": "https://github.com/shaharia-lab/agento",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Personal AI agent platform",
    "longDescription": "Agento runs your AI agents locally — scheduling them, giving them tools, and keeping every conversation and job on your own machine.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "epoch": 0
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNUFGN0YxQUNBRUEyMkMKUldRc29xNnM4ZmRhN0YvYkdDWlA2c3IwcTFJNWVlZ3dKR0QrSFI2M0E4ZG5wOWsxUXVDNHI4d3gK",
      "endpoints": [
        "https://github.com/shaharia-lab/agento/releases/download/desktop-latest/latest.json"
      ]
    }
  }
}
