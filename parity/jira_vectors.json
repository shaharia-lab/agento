      "tool": "list_projects",
      "arguments": {},
      "response": {
        "status": 204,
        "body": ""
      },
      "request": {
        "method": "GET",
        "target": "/rest/api/3/project",
        "authorization": "Basic cGFyaXR5QGV4YW1wbGUuY29tOnBhcml0eS1qaXJhLWFwaS10b2tlbg==",
