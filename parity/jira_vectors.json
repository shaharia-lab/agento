      "request": {
        "method": "GET",
        "target": "/rest/api/3/project/a$\u0026+:=@b%20my%20key%2Fx%3By%2Cz%3Fq%20caf%C3%A9%E6%97%A5%E6%9C%AC%E8%AA%9E",
